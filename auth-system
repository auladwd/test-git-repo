নতুন ব্রাঞ্চ তৈরি ও কাজ শুরু:
# নতুন ব্রাঞ্চ তৈরি করে সেটিতে সুইচ করা
git checkout -b feature/auth-system
# (অথবা আধুনিক বিকল্প: git switch -c feature/auth-system)

# ব্রাঞ্চের কাজ কমিট করা
git add .
git commit -m "Implement user login and registration forms"

# ফিচার ব্রাঞ্চটি GitHub-এ পুশ করা
git push -u origin feature/auth-system
Main ব্রাঞ্চে মার্জ করা (Local Merge):
# ১. মেইন ব্রাঞ্চে ফেরত যান
git checkout main

# ২. মেইন ব্রাঞ্চের লেটেস্ট পরিবর্তন নামিয়ে নিন
git pull origin main

# ৩. ফিচার ব্রাঞ্চটি মেইনে মার্জ করুন
git merge feature/auth-system

# ৪. আপডেট মেইন ব্রাঞ্চ পুশ করুন
git push origin main
